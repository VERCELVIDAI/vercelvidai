# ==============================================================================
# VERCEL VIDAI - APPLICATION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application
NEXT_PUBLIC_APP_NAME="Vercel Vidai"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"
APP_SECRET="super-secret-production-random-key-change-me"

# Demo Mode Flag (When true, simulated generation runs with explicit "Demo Mode" badges)
NEXT_PUBLIC_DEMO_MODE="true"

# Database Configuration (Supabase PostgreSQL in production, transactional local storage in dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vercel_vidai"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# PayU India Payment Gateway (Hosted Checkout, Subscriptions & GST Invoicing)
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""
PAYU_ENV="test" # "test" | "prod"
PAYU_WEBHOOK_SECRET=""

# AI Video, Image, Audio & Text Generation Providers
# (If left empty, system operates in safe, honest Demo Mode with sample outputs)
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""
RUNWAY_API_KEY=""
FAL_KEY=""
REPLICATE_API_TOKEN=""
LUMA_API_KEY=""

# Storage Configuration
STORAGE_PROVIDER="local" # "supabase" | "s3" | "local"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
